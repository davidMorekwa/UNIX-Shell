{
  "name": "mysh (C, gcc, gdb, valgrind)",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "ubuntu",
  "init": true,

  // Needed so gdb can attach to / follow child processes and valgrind can run.
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools",
        "hbenl.vscode-test-explorer"
      ],
      "settings": {
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "C_Cpp.default.cStandard": "gnu11",
        "C_Cpp.default.includePath": ["${workspaceFolder}/include"],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "postCreateCommand": "gcc --version | head -1 && make --version | head -1 && valgrind --version && strace -V | head -1"
}
